0 ' SET THE RTC CLOCK 1/12/2026
10 INPUT"Enter current time (12 hour) Hours,Minutes,Seconds,AM/PM)? ",H,M,S,AMPM$
15 IF AMPM$="PM" OR AMPM$="pm" OR AMPM$="P" OR AMPM$="p" THEN H=H+12
20 INPUT"Enter current MONTH(1-12),DAY(1-31),YEAR(20XX) ?",MONTH,DAY,YEAR
25 SAVEYEAR=YEAR:SAVEMIN=M:SAVEMONTH=MONTH
30 IF (MONTH<3) THEN MONTH=MONTH+12:YEAR=YEAR-1
60 WEEKDAY=(DAY+INT((MONTH+1)*2.6)+YEAR+INT(YEAR/4)-INT(YEAR/100)+INT(YEAR/400)) MOD 7
65 IF WEEKDAY=0 THEN WEEKDAY=7
70 GOSUB 600
75 PRINT:PRINT:GOSUB 800
80 END
600 REM ------ SET CURRENT TIME TO H:M:S
610 OUT 97,0:OUT 96,142: REM CLEAR WRITE PROTECT BIT
620 OUT 97,128:OUT 96,128:REM STOP CLOCK
630 R=2:D=H:GOSUB 700 ' SET HOURS
640 R=1:D=SAVEMIN:GOSUB 700 ' SET MINUTES
650 R=0:D=S:GOSUB 700 ' SET SECONDS
651 R=3:D=DAY:GOSUB 700 ' SET THE DAY
652 R=4:D=SAVEMONTH:GOSUB 700 ' SET THE MONTH
653 R=5:D=WEEKDAY:GOSUB 700 ' SET THE WEEKDAY
654 R=6:D=(SAVEYEAR MOD 100):GOSUB 700 ' SET THE YEAR
660 RETURN
700 REM ------ WRITE TO CLOCK REGISTER R
705 FOR DELAY=1 TO 50:NEXT DELAY
710 OUT 97,INT(D/10)*16+(D MOD 10)
720 OUT 96,128+(R AND 31)*2
730 RETURN


800 '**** Simple Command Line Time Display for Altair-Duino I/O Bus RTC clock ****
810 PM=0
820 ' READ SECONDS
830 OUT 96,129
840 IF INP(96) AND 128 THEN 840
850 D=INP(97)
860 D=INT(D/16)*10+(D AND 15)
870 S=D

900 'READ MINUTES
910 OUT 96,131
920 IF INP(96) AND 128 THEN 920
930 D=INP(97)
940 D=INT(D/16)*10+(D AND 15)
950 M=D

1060 'READ HOURS
1070 OUT 96,133
1080 IF INP(96) AND 128 THEN 1080
1090 D=INP(97)
1200 D=INT(D/16)*10+(D AND 15)
1210 H=D

1220 ' READ SECONDS ROLL OVER CHECK
1230 OUT 96,129
1240 IF INP(96) AND 128 THEN 1240
1250 D=INP(97)
1260 D=INT(D/16)*10+(D AND 15)
1270 IF D<S THEN GOTO 820

1280 'READ DAY
1290 OUT 96,135
1300 IF INP(96) AND 128 THEN 1300
1310 D=INP(97)
1320 D=INT(D/16)*10+(D AND 15)
1330 DAY=D

1340 'READ MONTH
1350 OUT 96,137
1360 IF INP(96) AND 128 THEN 1360
1370 D=INP(97)
1380 D=INT(D/16)*10+(D AND 15)
1390 MONTH=D

1400 'READ WEEKDAY
1410 OUT 96,139 
1420 IF INP(96) AND 128 THEN 1420
1430 D=INP(97)
1440 D=INT(D/16)*10+(D AND 15)
1450 WEEKDAY=D
 
1460 IF WEEKDAY=1 THEN WEEKDAY$="Sunday"
1470 IF WEEKDAY=2 THEN WEEKDAY$="Monday"
1480 IF WEEKDAY=3 THEN WEEKDAY$="Tuesday"
1490 IF WEEKDAY=4 THEN WEEKDAY$="Wednesday"
1500 IF WEEKDAY=5 THEN WEEKDAY$="Thursday"
1510 IF WEEKDAY=6 THEN WEEKDAY$="Friday"
1520 IF WEEKDAY=7 THEN WEEKDAY$="Saturday"

1530 'READ YEAR
1540 OUT 96,141
1550 IF INP(96) AND 128 THEN 1550
1560 D=INP(97)
1570 D=INT(D/16)*10+(D AND 15)
1580 YEAR=D

1590 IF (H>12) THEN H=H-12:PM=1
1600 IF (H=12) THEN PM=1
1610 IF (H=0) THEN H=12
1620 IF (PM=0) THEN PRINT "The current time is: " H":"M":"S" AM"
1630 IF (PM=1) THEN PRINT "The current time is: " H":"M":"S" PM"
1640 PRINT "The current date is: " WEEKDAY$" "MONTH"/"DAY"/"YEAR
1650 RETURN




